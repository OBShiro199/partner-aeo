# Supabase (Project settings > API keys)
NEXT_PUBLIC_SUPABASE_URL=https://nfnrezdqbunlrmdqmxzj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Leave unset to use Supabase. Set to 1 to run the whole app on sample data in the browser.
NEXT_PUBLIC_DEMO_MODE=

# Only used by `npm run dfs` (the local one-query tester). In production these live in
# Supabase function secrets: DATAFORSEO_LOGIN, DATAFORSEO_PASSWORD, ANTHROPIC_API_KEY.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
